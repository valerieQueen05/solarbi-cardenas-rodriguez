table 'dwh fact_energia_dia'
	lineageTag: 0474d781-0410-4f56-b73b-645f0e2574a0

	measure 'Energía (kWh)' =
			
			SUM ( 'dwh fact_energia_dia'[energia_kwh] )
		lineageTag: b5c3cb8d-292f-47cc-8207-1a3f116b1960

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Potencia instalada (kWp)' =
			
			SUM ( 'dwh dim_dispositivo'[potencia_kwp] )
		lineageTag: cc5276d7-7170-4762-bc01-b8fd8808cb3e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Yield (kWh/kWp)' =
			
			DIVIDE (
			    [Energía (kWh)],
			    [Potencia instalada (kWp)]
			)
		lineageTag: 9de45796-905e-46c2-8294-7f76c15325de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ahorro estimado (COP)' =
			
			[Energía (kWh)] * 958.38
		lineageTag: 80c98745-a3ba-4a0b-a11a-886884668451

		annotation PBI_FormatHint = {"isGeneralNumber":true}

